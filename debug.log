           {\\n                if(v[idx]!=(s[i]-t[i])) return false;\\n            }\\n        }\\n        for(int i=0;i<150;i++)\\n        {\\n            v[i]=1000;\\n        }\\n        for(int i=0;i<t.size();i++)\\n        {\\n            int idx=int(t[i]);\\n            if(v[idx]==1000) v[idx]=t[i]-s[i];\\n            else\\n            {\\n                if(v[idx]!=(t[i]-s[i])) return false;\\n            }\\n        }\\n        return true;\\n    }\\n};","compare_result":"111111111111111111111111111111111111111111111111","title_slug":"isomorphic-strings","has_notes":false,"flag_type":1,"frontend_id":27},{"id":2117816248,"question_id":14,"lang":"cpp","lang_name":"C++","time":"2\xc2\xa0weeks","timestamp":1787518515,"status":10,"status_display":"Accepted","runtime":"0 ms","url":"/submissions/detail/2117816248/","is_pending":"Not Pending","title":"Longest Common Prefix","memory":"12.1 MB","code":"class Solution {\\npublic:\\n    string longestCommonPrefix(vector<string>& strs) {\\n        int n=strs.size();\\n        string s=\\"\\";\\n        if(n==1) return strs[0];\\n        sort(strs.begin(),strs.end());\\n        string first=strs[0];\\n        string last=strs[n-1];\\n        for(int i=0;i<min(first.size(),last.size());i++)\\n        {\\n            if(first[i]==last[i]) s+=first[i];\\n            else return s;\\n        }\\n        return s;\\n    }\\n};","compare_result":"111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111","title_slug":"longest-common-prefix","has_notes":false,"flag_type":1,"frontend_id":26},{"id":2117089182,"question_id":242,"lang":"cpp","lang_name":"C++","time":"2\xc2\xa0weeks, 1\xc2\xa0day","timestamp":1787471661,"status":10,"status_display":"Accepted","runtime":"7 ms","url":"/submissions/detail/2117089182/","is_pending":"Not Pending","title":"Valid Anagram","memory":"9.8 MB","code":"class Solution {\\npublic:\\n    bool isAnagram(string s, string t) {\\n        string a=s;\\n        string b=t;\\n        sort(a.begin(),a.end());\\n        sort(b.begin(),b.end());\\n        if(a==b) return true;\\n        else return false;\\n    }\\n};","compare_result":"1111111111111111111111111111111111111111111111111111111","title_slug":"valid-anagram","has_notes":false,"flag_type":1,"frontend_id":25},{"id":2113014015,"question_id":891,"lang":"cpp","lang_name":"C++","time":"2\xc2\xa0weeks, 5\xc2\xa0days","timestamp":1787159778,"status":10,"status_display":"Accepted","runtime":"0 ms","url":"/submissions/detail/2113014015/","is_pending":"Not Pending","title":"Score After Flipping Matrix","memory":"11.3 MB","code":"class Solution {\\npublic:\\n    int matrixScore(vector<vector<int>>& grid) {\\n        int r=grid.size();\\n        int c=grid[0].size();\\n        //making the elements of first column 1\\n        for(int i=0;i<r;i++)\\n        {\\n            if(grid[i][0]==0)\\n            {\\n                for(int j=0;j<c;j++)\\n                {\\n                    if(grid[i][j]==0) grid[i][j]=1;\\n                    else grid[i][j]=0;\\n                }\\n            }\\n        }\\n        //flip column where no of zeros>no of ones\\n        for(int j=0;j<c;j++)\\n        {\\n            int noz=0,noo=0;\\n            for(int i=0;i<r;i++)\\n            {\\n                if(grid[i][j]==0) noz++;\\n                else noo++;\\n            }\\n            if(noz>noo)\\n            {\\n                for(int i=0;i<r;i++)\\n                {\\n                    if(grid[i][j]==0) grid[i][j]=1;\\n                    else grid[i][j]=0;\\n                }\\n            }\\n        }\\n        int sum=0;\\n        for(int i=0;i<r;i++)\\n        {\\n            int x=1;\\n            for(int j=c-1;j>=0;j--)\\n            {\\n                sum+=grid[i][j]*x;\\n                x*=2;\\n            }\\n        }\\n        return sum;\\n    }\\n};","compare_result":"11111111111111111111111111111111111111111111111111111111111111111111111111111111","title_slug":"score-after-flipping-matrix","has_notes":false,"flag_type":1,"frontend_id":24},{"id":2112999838,"question_id":240,"lang":"cpp","lang_name":"C++","time":"2\xc2\xa0weeks, 5\xc2\xa0days","timestamp":1787159205,"status":10,"status_display":"Accepted","runtime":"47 ms","url":"/submissions/detail/2112999838/","is_pending":"Not Pending","title":"Search a 2D Matrix II","memory":"18.8 MB","code":"class Solution {\\npublic:\\n    bool searchMatrix(vector<vector<int>>& matrix, int target) {\\n        int r=matrix.size();\\n        int c=matrix[0].size();\\n        int x=0;\\n        int y=c-1;\\n        while(x<=r-1 && y>=0)\\n        {\\n            if(matrix[x][y]==target) return true;\\n            else if(matrix[x][y]>target) y--;\\n            else x++;\\n        }\\n        return false;\\n    }\\n};","compare_result":"1111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111","title_slug":"search-a-2d-matrix-ii","has_notes":false,"flag_type":1,"frontend_id":23},{"id":2111855591,"question_id":59,"lang":"cpp","lang_name":"C++","time":"2\xc2\xa0weeks, 5\xc2\xa0days","timestamp":1787076928,"status":10,"status_display":"Accepted","runtime":"2 ms","url":"/submissions/detail/2111855591/","is_pending":"Not Pending","title":"Spiral Matrix II","memory":"9.4 MB","code":"class Solution {\\npublic:\\n    vector<vector<int>> generateMatrix(int n) {\\n        vector<vector <int>>v(n,vector<int>(n));\\n        int minr=0,minc=0,maxr=n-1,maxc=n-1;\\n        int tne=n*n;\\n        int a=1;\\n        while(minr<=maxr && minc<=maxc)\\n        {\\n            for(int j=minc;j<=maxc&&a<=tne;j++)\\n            {\\n                v[minr][j]=a;\\n                a++;\\n            }\\n            minr++;\\n            for(int i=minr;i<=maxr&&a<=tne;i++)\\n            {\\n                v[i][maxc]=a;\\n                a++;\\n            }\\n            maxc--;\\n            for(int j=maxc;j>=min