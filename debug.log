ype":1,"frontend_id":13},{"id":2105825616,"question_id":1,"lang":"cpp","lang_name":"C++","time":"3\xc2\xa0weeks, 3\xc2\xa0days","timestamp":1786644818,"status":10,"status_display":"Accepted","runtime":"100 ms","url":"/submissions/detail/2105825616/","is_pending":"Not Pending","title":"Two Sum","memory":"14 MB","code":"class Solution {\\npublic:\\n    vector<int> twoSum(vector<int>& nums, int target) {\\n        vector<int> v;\\n        bool flag=false;\\n        int n=nums.size();\\n        for(int i=0;i<n;i++)\\n        {\\n            for(int j=i+1;j<n;j++)\\n            {\\n                if(nums[i]+nums[j]==target)\\n                {\\n                    v.push_back(i);\\n                    v.push_back(j);\\n                    flag=true;\\n                    break;\\n                }\\n            }\\n            if(flag) break;\\n        }\\n        return v;\\n    }\\n};","compare_result":"11111111111111111111111111111111111111111111111111111111111111111","title_slug":"two-sum","has_notes":false,"flag_type":1,"frontend_id":12},{"id":2104403921,"question_id":2876,"lang":"c","lang_name":"C","time":"3\xc2\xa0weeks, 5\xc2\xa0days","timestamp":1786550040,"status":10,"status_display":"Accepted","runtime":"0 ms","url":"/submissions/detail/2104403921/","is_pending":"Not Pending","title":"Number of Employees Who Met the Target","memory":"9.5 MB","code":"int numberOfEmployeesWhoMetTarget(int* hours, int hoursSize, int target) {\\n    int c=0;\\n    for(int i=0;i<hoursSize;i++)\\n    {\\n        if(hours[i]>=target) c+=1;\\n    }\\n    return c;\\n}","compare_result":"","title_slug":"number-of-employees-who-met-the-target","has_notes":false,"flag_type":1,"frontend_id":11},{"id":2103250590,"question_id":3515,"lang":"c","lang_name":"C","time":"3\xc2\xa0weeks, 6\xc2\xa0days","timestamp":1786470427,"status":10,"status_display":"Accepted","runtime":"4 ms","url":"/submissions/detail/2103250590/","is_pending":"Not Pending","title":"Find if Digit Game Can Be Won","memory"