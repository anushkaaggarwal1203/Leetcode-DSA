 int n=nums.size();\\n        vector<int> pre(n);\\n        pre[0]=1;\\n        int p=nums[0];\\n        for(int i=1;i<n;i++)\\n        {\\n            pre[i]=p;\\n            p*=nums[i];\\n        }\\n        p=nums[n-1];\\n        for(int i=n-2;i>=0;i--)\\n        {\\n            pre[i]*=p;\\n            p*=nums[i];\\n        }\\n        return pre;\\n    }\\n};","compare_result":"111111111111111111111111","title_slug":"product-of-array-except-self","has_notes":false,"flag_type":1,"frontend_id":32},{"id":2123238715,"question_id":2576,"lang":"cpp","lang_name":"C++","time":"1\xc2\xa0week, 2\xc2\xa0days","timestamp":1787944485,"status":10,"status_display":"Accepted","runtime":"9 ms","url":"/submissions/detail/2123238715/","is_pending":"Not Pending","title":"Minimum Penalty for a Shop","memory":"14.3 MB","code":"class Solution {\\npublic:\\n    int bestClosingTime(string customers) {\\n        int n=customers.size();\\n        int pre[n+1];\\n        int suf[n+1];\\n        pre[0]=0;\\n        for(int i=1;i<=n;i++)\\n        {\\n            if(customers[i-1]==\'N\') pre[i]=pre[i-1]+1;\\n            else pre[i]=pre[i-1];\\n        }\\n        suf[n]=0;\\n        for(int i=n-1;i>=0;i--)\\n        {\\n            if(customers[i]==\'Y\') suf[i]=suf[i+1]+1;\\n            else suf[i]=suf[i+1];\\n        }\\n        int minp=INT_MAX;\\n        for(int i=0;i<=n;i++)\\n        {\\n            pre[i]+=suf[i];\\n            minp=min(minp,pre[i]);\\n        }\\n        for(int i=0;i<=n;i++)\\n        {\\n            if(pre[i]==minp) return i;\\n        }\\n        return 0;\\n    }\\n};","compare_result":"111111111111111111111111111111111111111111","title_slug":"minimum-penalty-for-a-shop","has_notes":false,"flag_type":1,"frontend_id":31},{"id":2123226934,"question_id":238,"lang":"cpp","lang_name":"C++","time":"1\xc2\xa0week, 2\xc2\xa0days","timestamp":1787943469,"status":10,"status_display":"Accepted","runtime":"0 ms","url":"/submissions/detail/2123226934/","is_pending":"Not Pending","title":"Product of Array Except Self","memory":"40.2 MB","code":"class Solution {\\npublic:\\n    vector<int> productExceptSelf(vector<int>& nums) {\\n        int n=nums.size();\\n        vector<int> pre(n);\\n        pre[0]=1;\\n        int p=nums[0];\\n        for(int i=1;i<n;i++)\\n        {\\n            pre[i]=p;\\n            p*=nums[i];\\n        }\\n        p=nums[n-1];\\n        for(int i=n-2;i>=0;i--)\\n        {\\n            pre[i]*=p;\\n            p*=nums[i];\\n        }\\n        return pre;\\n    }\\n};","compare_result":"111111111111111111111111","title_slug":"product-of-array-except-self","has_notes":false,"flag_type":1,"frontend_id":30}],"has_next":true,"last_key":""}'
